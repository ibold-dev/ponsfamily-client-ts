{
  "name": "@robhdev/pons-client",
  "version": "0.1.0",
  "description": "Industry-standard TypeScript client for the Pons v2 token launch protocol on Robinhood Chain",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "pons",
    "robinhood",
    "defi",
    "token-launch",
    "bonding-curve",
    "uniswap-v4",
    "ethereum",
    "evm"
  ],
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
