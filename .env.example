# Robinhood Chain RPC endpoint
RPC_URL=https://rpc.robinhood.com

# Wallet private key (for write operations: launching, claiming, releasing, swapping)
PRIVATE_KEY=0x...

# Live contract addresses (from a real Pons v2 launch)
TOKEN_ADDRESS=0x...
CURVE_ADDRESS=0x...

# For event indexing — starting block number
FROM_BLOCK=0

# For fee claiming — creator address and optional ERC-20 quote asset
CREATOR_ADDRESS=0x...
QUOTE_ASSET=0x...

# For example 03 — recipient wallet (optional, defaults to 0x...0001)
RECIPIENT=0x...

# For examples 11 & 12 — curve swaps
BUY_AMOUNT=0.01        # ETH to spend (example 11)
SELL_AMOUNT=1000000    # token amount to sell (example 12)
SLIPPAGE_BPS=100       # slippage tolerance in bps, default 1% (optional)
